# ============================================================================
# ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this file to .env.local in your repo and fill in the real values.
# NEVER commit .env.local — it contains secrets.
#
#   cp .env.example .env.local
#
# ============================================================================

# ----------------------------------------------------------------------------
# JIRA
# ----------------------------------------------------------------------------
# Get your API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
#
# JIRA_API_TOKEN below is a fallback only (Fase 4.2, update-plan-aug-2026.md):
# registry/scripts/{auto-jira,dashboard}.js check your OS keychain FIRST and
# only read this file if that lookup fails. Store it in the keychain once
# instead of filling in the line below:
#   macOS:  security add-generic-password -a "$JIRA_EMAIL" -s ai-setup-jira -w "<token>"
#   Linux:  echo -n "<token>" | secret-tool store --label="AI-Setup Jira" service ai-setup-jira account "$JIRA_EMAIL"
#   Windows: no CLI keychain reader is wired up yet — this file is the only
#            option there for now.
JIRA_HOST=yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# ----------------------------------------------------------------------------
# GITHUB
# ----------------------------------------------------------------------------
# GITHUB_TOKEN below is a fallback only: registry/scripts/{auto-pr,dashboard}.js
# run `gh auth token` first and only use this file if that's unset or `gh`
# isn't installed/logged in. Prefer `gh auth login` over filling this in —
# nothing then needs to sit in the clear on disk.
GITHUB_TOKEN=
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# ----------------------------------------------------------------------------
# GIT (commit author identity for automated commits)
# ----------------------------------------------------------------------------
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your-email@company.com

# ----------------------------------------------------------------------------
# GPG (optional — for signed commits)
# ----------------------------------------------------------------------------
# Get your key ID with: gpg --list-secret-keys --keyid-format LONG
GPG_KEY_ID=
